# .env.example — copy to .env and fill in your values
# .env is gitignored and must be created manually.

# Default sync target — used when no target name is passed as argument
DEFAULT_TARGET=robot

# Target definitions: <NAME>_USER, <NAME>_IP, <NAME>_PATH
# Add as many targets as needed.
robot_USER=<ssh-user>
robot_IP=<ip-address>
robot_PATH=/path/to/repo

lan_USER=<ssh-user>
lan_IP=<lan-ip-address>
lan_PATH=/path/to/repo
